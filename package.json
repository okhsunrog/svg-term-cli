{
  "name": "svg-term-cli",
  "version": "2.1.1",
  "description": "Share terminal sessions as razor-sharp animated SVG everywhere",
  "type": "module",
  "bin": {
    "svg-term": "./lib/cli.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.json",
    "format": "bunx prettier \"src/**/*.ts\" --write",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marionebl/svg-term-cli.git"
  },
  "keywords": [
    "svg",
    "asciinema",
    "asciicast"
  ],
  "author": "Mario Nebl <hello@mario-nebl.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marionebl/svg-term-cli/issues"
  },
  "homepage": "https://github.com/marionebl/svg-term-cli#readme",
  "dependencies": {
    "@marionebl/sander": "^0.6.1",
    "chalk": "^5.3.0",
    "command-exists": "^1.2.9",
    "execa": "^0.8.0",
    "get-stdin": "^5.0.1",
    "guess-terminal": "^1.0.0",
    "macos-app-config": "^1.0.1",
    "meow": "^13.2.0",
    "plist": "^2.1.0",
    "svg-term": "^1.3.1",
    "svgo": "^1.3.2",
    "tempfile": "^2.0.0",
    "tempy": "^0.2.1",
    "term-schemes": "^1.2.1"
  },
  "devDependencies": {
    "@types/command-exists": "^1.2.3",
    "@types/execa": "^0.8.1",
    "@types/get-stdin": "^5.0.1",
    "@types/meow": "^3.6.2",
    "@types/plist": "^3.0.5",
    "@types/tempfile": "^2.0.0",
    "@types/tempy": "^0.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "@xmldom/xmldom": "^0.9.8"
  }
}
